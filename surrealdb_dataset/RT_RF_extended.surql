, 1851], [1851, 1872], [1872, 1910], [1910, 1988], [1988, 2043], [2043, 2115], [2115, 2154], [2154, 2226], [2226, 2253], [2253, 2268], [2268, 2310], [2310, 2362], [2362, 2386], [2386, 2420], [2420, 2514]] }, { id: reasoning_flow_gold:29, labels: ['restatement', 'reflection', 'planning', 'fact', 'fact', 'restatement', 'reasoning', 'reasoning', 'reasoning', 'reflection', 'planning', 'fact', 'planning', 'fact', 'restatement', 'fact', 'fact', 'reasoning', 'planning', 'planning', 'fact', 'reasoning', 'reflection', 'planning', 'fact', 'reflection', 'planning', 'fact', 'reflection', 'planning', 'fact', 'reflection', 'planning', 'fact', 'fact', 'fact', 'restatement', 'reasoning', 'fact', 'fact', 'assumption', 'reasoning', 'reasoning', 'planning', 'planning', 'fact', 'reflection', 'planning', 'reasoning', 'reflection', 'planning', 'fact', 'planning', 'restatement', 'planning', 'reasoning', 'reasoning', 'planning', 'reflection', 'planning', 'reasoning', 'planning', 'reflection', 'planning', 'planning', 'reasoning', 'fact', 'fact', 'fact', 'reasoning', 'planning', 'reasoning', 'reflection', 'planning', 'planning', 'reasoning', 'reasoning', 'fact', 'reasoning', 'planning', 'assumption', 'reasoning', 'reasoning', 'planning', 'reflection', 'planning', 'reasoning', 'reflection', 'planning', 'fact', 'reasoning', 'reasoning', 'planning', 'fact', 'fact', 'reasoning', 'planning', 'planning', 'reflection', 'planning', 'reasoning', 'planning', 'fact', 'reasoning', 'reasoning', 'planning', 'reflection', 'planning', 'planning', 'reasoning', 'reflection', 'reflection', 'reasoning', 'planning', 'reasoning', 'reflection', 'conclusion'], split: [[0, 196], [196, 239], [239, 312], [312, 515], [515, 623], [623, 745], [745, 893], [893, 1024], [1024, 1115], [1115, 1162], [1162, 1182], [1182, 1323], [1323, 1376], [1376, 1534], [1534, 1576], [1576, 1717], [1717, 1814], [1814, 1926], [1926, 2038], [2038, 2175], [2175, 2293], [2293, 2379], [2379, 2418], [2418, 2543], [2543, 2657], [2657, 2702], [2702,